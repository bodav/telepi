{
  "name": "telepi",
  "version": "0.2.0",
  "description": "A Telegram client for the terminal, built for people who live in their CLI",
  "type": "module",
  "bin": {
    "telepi": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "telegram",
    "tui",
    "cli",
    "ink",
    "mtproto"
  ],
  "license": "MIT",
  "dependencies": {
    "@mtcute/markdown-parser": "^0.32.8",
    "@mtcute/node": "^0.32.8",
    "ink": "^8.0.0",
    "qr": "^0.7.2",
    "react": "^19.3.1",
    "string-width": "^8.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "react-devtools-core": "^6.1.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
